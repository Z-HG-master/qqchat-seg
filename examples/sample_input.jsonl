{"msg_id":"m0012","ts":1788190866,"sender_uid":"u1001","sender_name":"示例用户A","text":"放心，下山就饿了。","at_uids":[],"reply_to_msg_id":null,"media":[]}
{"msg_id":"m0013","ts":1788190920,"sender_uid":"u1002","sender_name":"示例用户B","text":"对了，新出那个小游戏你们玩了吗？","at_uids":[],"reply_to_msg_id":null,"media":[]}
