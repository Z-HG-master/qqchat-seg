{"msg_id":"m0008","ts":1788190801,"sender_uid":"u1001","sender_name":"示例用户A","text":"看着不错，哪家店买的？","at_uids":[],"reply_to_msg_id":"m0007","media":[]}
{"msg_id":"m0009","ts":1788190814,"sender_uid":"u1004","sender_name":"示例用户D","text":"楼下那家新开的，还买三送一。","at_uids":[],"reply_to_msg_id":null,"media":[]}
