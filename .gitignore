# ============================================================
# 数据与运行产物：绝对不能提交
# ============================================================
# 聊天记录、日志、数据库、任何导出的数据集
data/
logs/
bench/data/
bench/results/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.parquet
*.csv
*.jsonl

# 媒体文件（图片/音视频）
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.mp3
*.wav
*.mp4
*.m4a

# 用户自己的配置（含群号/模型名/端点）
config.json

# ============================================================
# 例外：仓库自带的编造样例必须被跟踪
#   - 两份 jsonl 都是编造内容（示例用户A/B、群号 123456789）
#   - examples/media/ 下三张图是程序合成的占位图，不含真实照片或个人信息
# 注意：否定规则要写在对应忽略规则之后才生效
# ============================================================
!examples/sample_input.jsonl
!examples/sample_input_media.jsonl
!examples/media/
!examples/media/*.png
!examples/media/*.jpg

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ============================================================
# 编辑器 / 操作系统
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
